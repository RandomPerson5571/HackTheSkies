# Public Mapbox token (pk.*). Never put a secret sk.* token here.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Optional custom Mapbox Studio style. Defaults to Mapbox Light.
EXPO_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/light-v11
# One HTTPS Worker origin for food, menu, recommendations and quests.
# Local Worker: http://localhost:8787 (Android emulator: http://10.0.2.2:8787).
# Production: use the URL printed by `pnpm deploy:api`.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Supabase public project configuration
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional per-route overrides. Leave unset to use EXPO_PUBLIC_API_URL.
# EXPO_PUBLIC_FOOD_SCAN_URL=
# EXPO_PUBLIC_FOOD_RECOMMENDATIONS_URL=
# EXPO_PUBLIC_MENU_SCAN_URL=
# EXPO_PUBLIC_QUEST_URL=
