# Public Mapbox token (pk.*). Never put a secret sk.* token here.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Optional custom Mapbox Studio style. Defaults to Mapbox Light.
EXPO_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/light-v11
# Optional recognition server. Use your computer's LAN IP for a physical device.
# Run pnpm dev or pnpm dev:server with GROQ_API_KEY in .env.server.local.
EXPO_PUBLIC_FOOD_SCAN_URL=http://localhost:3000/api/food-scan

# Supabase public project configuration
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Included Groq API server (use your computer’s LAN IP on a physical device).
EXPO_PUBLIC_FOOD_RECOMMENDATIONS_URL=http://localhost:3000/api/food-recommendations

# Optional; defaults to /api/menu-scan on the food scan server.
EXPO_PUBLIC_MENU_SCAN_URL=http://localhost:3000/api/menu-scan

# Optional; defaults to /api/quest-personalization on the food scan server.
EXPO_PUBLIC_QUEST_URL=http://localhost:3000/api/quest-personalization
