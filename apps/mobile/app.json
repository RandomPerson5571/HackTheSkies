{
  "expo": {
    "name": "HackTheSkies",
    "slug": "hack-the-skies",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boberto2790.hack-the-skies"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@rnmapbox/maps",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow HackTheSkies to photograph food for your Food Dex.",
          "photosPermission": "Allow HackTheSkies to choose food photos for your Food Dex.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
