{
  "name": "HackTheSkies",
  "private": true,
  "scripts": {
    "db:setup": "node --env-file=.env.local scripts/setup-supabase.mjs",
    "db:verify": "node --env-file=.env.local --env-file=apps/mobile/.env.local scripts/verify-supabase.mjs",
    "catalog:import": "node --env-file-if-exists=.env.local scripts/import-food-catalog.mjs",
    "test:catalog": "node --test scripts/tests/foodCatalog.test.mjs",
    "build": "turbo run build",
    "dev": "pnpm --filter mobile dev",
    "dev:web": "pnpm --filter mobile web",
    "dev:mobile": "pnpm --filter mobile dev",
    "ios": "pnpm --filter mobile ios",
    "android": "pnpm --filter mobile android",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "dev:server": "pnpm --filter @cibo/api dev",
    "start": "pnpm --filter @cibo/api dev",
    "test": "pnpm --filter mobile test && pnpm --filter @cibo/api test",
    "deploy:api": "pnpm --filter @cibo/api run deploy",
    "check:api": "pnpm --filter @cibo/api check-types"
  },
  "devDependencies": {
    "postgres": "^3.4.9",
    "prettier": "3.9.6",
    "turbo": "^2.11.8",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
