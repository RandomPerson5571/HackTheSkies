{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "GROQ_API_KEY",
        "GROQ_MENU_SCAN_MODEL",
        "GROQ_FOOD_SCAN_MODEL"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "GROQ_API_KEY",
        "GROQ_MENU_SCAN_MODEL",
        "GROQ_FOOD_SCAN_MODEL",
        "GROQ_RECOMMENDATION_MODEL",
        "CIBO_REMOTE_API"
      ]
    }
  },
  "globalDependencies": [
    "packages/food-catalog/**"
  ]
}
